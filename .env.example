ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
DATABASE_URL=sqlite:///./kami_sim.db
CHROMA_PATH=./chroma_data
# Use "chroma" only where the native Chroma backend passes a local upsert smoke-test.
MEMORY_VECTOR_BACKEND=sql
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KAMI_API_TOKEN=
# 0 disables the default cap. Individual simulations can override this via API.
SIMULATION_BUDGET_USD=0
# Jump directly to the next schedule/wake/arrival while every agent is dormant.
ADAPTIVE_TIME_STEPPING=true

# Provider can be anthropic, openai, or gemini.
LLM_PROVIDER=anthropic

# Models can use the global provider, or override it with a provider prefix:
# CHEAP_MODEL=openai:gpt-4.1-mini
# STRONG_MODEL=gemini:gemini-2.5-pro
CHEAP_MODEL=claude-haiku-4-5-20251001
STRONG_MODEL=claude-sonnet-4-6
